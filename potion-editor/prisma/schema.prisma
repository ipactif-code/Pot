generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified Boolean   @default(false)
  name          String?
  image         String?
  username      String?   @unique
  role          String    @default("user")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions  Session[]
  accounts  Account[]
  documents Document[]
  comments  Comment[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id           String  @id @default(cuid())
  userId       String
  provider     String
  providerType String
  providerId   String
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@unique([identifier, value])
  @@map("verifications")
}

model Document {
  id               String    @id @default(cuid())
  templateId       String?
  userId           String
  parentDocumentId String?
  
  title            String?
  content          String?   @db.Text
  contentRich      Json?
  yjsSnapshot      Bytes?
  
  coverImage       String?
  icon             String?
  
  isPublished      Boolean   @default(false)
  isArchived       Boolean   @default(false)
  lockPage         Boolean   @default(false)
  
  textStyle        String    @default("DEFAULT")
  smallText        Boolean   @default(false)
  fullWidth        Boolean   @default(false)
  toc              Boolean   @default(false)
  
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentDocument   Document?     @relation("DocumentHierarchy", fields: [parentDocumentId], references: [id], onDelete: Cascade)
  childDocuments   Document[]    @relation("DocumentHierarchy")
  versions         DocumentVersion[]
  discussions      Discussion[]
  files            File[]

  @@index([userId])
  @@index([parentDocumentId])
  @@index([templateId])
  @@map("documents")
}

model DocumentVersion {
  id          String   @id @default(cuid())
  documentId  String
  title       String?
  contentRich Json
  createdAt   DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("document_versions")
}

model Discussion {
  id              String   @id @default(cuid())
  documentId      String
  documentContent String   @db.Text
  isResolved      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  document Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  comments Comment[]

  @@index([documentId])
  @@map("discussions")
}

model Comment {
  id           String   @id @default(cuid())
  discussionId String
  userId       String
  content      String   @db.Text
  contentRich  Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  discussion Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([discussionId])
  @@index([userId])
  @@map("comments")
}

model File {
  id         String   @id @default(cuid())
  documentId String?
  url        String
  name       String
  size       Int
  type       String
  createdAt  DateTime @default(now())

  document Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([documentId])
  @@map("files")
}
